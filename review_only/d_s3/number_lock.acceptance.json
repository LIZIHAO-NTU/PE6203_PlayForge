  "manual_checks": [
    {
      "requirement_id": "R7",
      "instruction": "On a fresh page, confirm the interface text is English and the visible #guess, #submit, #restart controls and main game region exist. Record screenshot. Treat a full rules paragraph and enhanced accessible names as usability recommendations, not hard failures unless added to the original spec before freeze."
    },
    {
      "requirement_id": "R5",
      "instruction": "Using normal player actions on separate fresh pages, reach Won with guess 7 and Lost with wrong guesses 1, 2, 3. For each terminal state, if #submit is enabled, attempt another submission and verify attempts, phase and feedback stay unchanged; if #submit is disabled, verify it cannot be activated by normal player input and the displayed state remains unchanged. The input may also be disabled. Record which permitted behavior was observed and preserve separate evidence for Won and Lost."
    },
    {
      "requirement_id": "R1",
      "instruction": "On a fresh page, focus #guess, type 2, press Enter without clicking Submit, and verify attempts=0, phase=Playing, feedback=Ready. Then click Submit and verify 1/Playing/Too low. Record visible values and read-only state. This manual check covers the no-Enter-submission rule."
    }
  ]
}
