{
  "supported": true,
  "reason": "Independent regression plan for the existing collector example; not an unknown-game template.",
  "title": "Star Collector: Observation-Based Independent Regression Acceptance",
  "development_plan": ["Recheck the existing game only; do not generate or modify any game code"],
  "state_contract": {
    "score": "Actual score", "player.x": "Actual player x-coordinate", "player.y": "Actual player y-coordinate",
    "star.x": "Actual current-star x-coordinate", "star.y": "Actual current-star y-coordinate",
    "paused": "Actual pause state", "won": "Actual win state", "phase": "Actual phase"
  },
  "requirements": [
    {"id": "R1", "text": "Canvas 640×420; player starts at middle left, star at middle right", "verification": "automated"},
    {"id": "R2", "text": "Arrow keys move the player continuously", "verification": "automated"},
    {"id": "R3", "text": "Touching the star adds 10 points and relocates it", "verification": "automated"},
    {"id": "R4", "text": "Win at 30 points; show a message and stop normal movement", "verification": "automated"},
    {"id": "R5", "text": "P pauses and freezes player state; press P again to resume", "verification": "automated"},
    {"id": "R6", "text": "Restart resets score, player, star, win/loss and pause state", "verification": "automated"},
    {"id": "R7", "text": "Colors, smoothness, text legibility, full-square boundary containment and state-hook fidelity", "verification": "manual"}
  ],
  "tests": [
    {"id": "T1", "requirement_ids": ["R1"], "description": "Independently measure the canvas and check the initial spatial layout", "steps": [
      {"action": "assert", "source": "surface", "selector": "canvas", "property": "width", "op": "eq", "value": 640},
      {"action": "assert", "source": "surface", "selector": "canvas", "property": "height", "op": "eq", "value": 420},
      {"action": "assert", "source": "state", "path": "player.x", "op": "lt", "value": 160},
      {"action": "assert", "source": "state", "path": "player.y", "op": "gt", "value": 140},
      {"action": "assert", "source": "state", "path": "player.y", "op": "lt", "value": 280},
      {"action": "assert", "source": "state", "path": "star.x", "op": "gt", "value": 480},
      {"action": "assert", "source": "state", "path": "star.y", "op": "gt", "value": 140},
      {"action": "assert", "source": "state", "path": "star.y", "op": "lt", "value": 280}
    ]},
    {"id": "T2", "requirement_ids": ["R2"], "description": "Confirm horizontal and vertical movement using actual positions", "steps": [
      {"action": "capture", "name": "initial"},
      {"action": "key_until", "key": "ArrowRight", "until": {"source": "state", "path": "player.x", "op": "ge", "value": 90}, "timeout_ms": 1000},
      {"action": "assert", "source": "state", "path": "player.x", "op": "gt", "value_from": {"capture": "initial", "path": "player.x"}},
      {"action": "key_until", "key": "ArrowDown", "until": {"source": "state", "path": "player.y", "op": "ge", "value": 250}, "timeout_ms": 1000},
      {"action": "assert", "source": "state", "path": "player.y", "op": "gt", "value_from": {"capture": "initial", "path": "player.y"}}
    ]},
    {"id": "T3", "requirement_ids": ["R3"], "description": "Move to the star with real keys; verify scoring and position changes", "steps": [
      {"action": "capture", "name": "initial"},
      {"action": "move_to", "actor": {"x": "player.x", "y": "player.y"}, "target": {"x": "star.x", "y": "star.y"}, "keys": {"left": "ArrowLeft", "right": "ArrowRight", "up": "ArrowUp", "down": "ArrowDown"}, "until": {"source": "state", "path": "score", "op": "eq", "value": 10}, "timeout_ms": 5000},
      {"action": "assert", "source": "state", "path": "score", "op": "eq", "value": 10},
      {"action": "assert", "source": "text", "selector": "#score", "op": "contains", "value": "10"},
      {"action": "assert", "source": "state", "path": "star", "op": "ne", "value_from": {"capture": "initial", "path": "star"}}
    ]},
    {"id": "T4", "requirement_ids": ["R3", "R4"], "description": "Collect three times; check the victory message and movement lock", "steps": [
      {"action": "move_to", "actor": {"x": "player.x", "y": "player.y"}, "target": {"x": "star.x", "y": "star.y"}, "keys": {"left": "ArrowLeft", "right": "ArrowRight", "up": "ArrowUp", "down": "ArrowDown"}, "until": {"source": "state", "path": "score", "op": "eq", "value": 10}, "timeout_ms": 5000},
      {"action": "move_to", "actor": {"x": "player.x", "y": "player.y"}, "target": {"x": "star.x", "y": "star.y"}, "keys": {"left": "ArrowLeft", "right": "ArrowRight", "up": "ArrowUp", "down": "ArrowDown"}, "until": {"source": "state", "path": "score", "op": "eq", "value": 20}, "timeout_ms": 5000},
      {"action": "move_to", "actor": {"x": "player.x", "y": "player.y"}, "target": {"x": "star.x", "y": "star.y"}, "keys": {"left": "ArrowLeft", "right": "ArrowRight", "up": "ArrowUp", "down": "ArrowDown"}, "until": {"source": "state", "path": "score", "op": "eq", "value": 30}, "timeout_ms": 5000},
      {"action": "assert", "source": "state", "path": "score", "op": "eq", "value": 30},
      {"action": "assert", "source": "state", "path": "won", "op": "eq", "value": true},
      {"action": "assert", "source": "visible", "selector": "#victory", "op": "eq", "value": true},
      {"action": "capture", "name": "won"},
      {"action": "key", "key": "ArrowRight", "hold_ms": 300},
      {"action": "assert", "source": "state", "path": "player", "op": "eq", "value_from": {"capture": "won", "path": "player"}}
    ]},
    {"id": "T5", "requirement_ids": ["R5"], "description": "Pause, attempt movement, resume and move", "steps": [
      {"action": "key", "key": "p"},
      {"action": "capture", "name": "paused"},
      {"action": "assert", "source": "state", "path": "paused", "op": "eq", "value": true},
      {"action": "key", "key": "ArrowRight", "hold_ms": 300},
      {"action": "assert", "source": "state", "path": "player", "op": "eq", "value_from": {"capture": "paused", "path": "player"}},
      {"action": "assert", "source": "state", "path": "score", "op": "eq", "value_from": {"capture": "paused", "path": "score"}},
      {"action": "key", "key": "p"},
      {"action": "assert", "source": "state", "path": "paused", "op": "eq", "value": false},
      {"action": "key_until", "key": "ArrowRight", "until": {"source": "state", "path": "player.x", "op": "ge", "value": 90}, "timeout_ms": 1000},
      {"action": "assert", "source": "state", "path": "player.x", "op": "gt", "value_from": {"capture": "paused", "path": "player.x"}}
    ]},
    {"id": "T6", "requirement_ids": ["R6"], "description": "Restart after scoring and pausing", "steps": [
      {"action": "capture", "name": "initial"},
      {"action": "move_to", "actor": {"x": "player.x", "y": "player.y"}, "target": {"x": "star.x", "y": "star.y"}, "keys": {"left": "ArrowLeft", "right": "ArrowRight", "up": "ArrowUp", "down": "ArrowDown"}, "until": {"source": "state", "path": "score", "op": "eq", "value": 10}, "timeout_ms": 5000},
      {"action": "key", "key": "p"},
      {"action": "assert", "source": "state", "path": "paused", "op": "eq", "value": true},
      {"action": "click", "selector": "#restart"},
      {"action": "assert", "source": "state", "path": "score", "op": "eq", "value": 0},
      {"action": "assert", "source": "state", "path": "player", "op": "eq", "value_from": {"capture": "initial", "path": "player"}},
      {"action": "assert", "source": "state", "path": "star", "op": "eq", "value_from": {"capture": "initial", "path": "star"}},
      {"action": "assert", "source": "state", "path": "paused", "op": "eq", "value": false},
      {"action": "assert", "source": "state", "path": "won", "op": "eq", "value": false}
    ]},
    {"id": "T7", "requirement_ids": ["R6"], "description": "Restart after an actual win and confirm exit from the winning state", "steps": [
      {"action": "capture", "name": "initial"},
      {"action": "move_to", "actor": {"x": "player.x", "y": "player.y"}, "target": {"x": "star.x", "y": "star.y"}, "keys": {"left": "ArrowLeft", "right": "ArrowRight", "up": "ArrowUp", "down": "ArrowDown"}, "until": {"source": "state", "path": "score", "op": "eq", "value": 10}, "timeout_ms": 5000},
      {"action": "move_to", "actor": {"x": "player.x", "y": "player.y"}, "target": {"x": "star.x", "y": "star.y"}, "keys": {"left": "ArrowLeft", "right": "ArrowRight", "up": "ArrowUp", "down": "ArrowDown"}, "until": {"source": "state", "path": "score", "op": "eq", "value": 20}, "timeout_ms": 5000},
      {"action": "move_to", "actor": {"x": "player.x", "y": "player.y"}, "target": {"x": "star.x", "y": "star.y"}, "keys": {"left": "ArrowLeft", "right": "ArrowRight", "up": "ArrowUp", "down": "ArrowDown"}, "until": {"source": "state", "path": "score", "op": "eq", "value": 30}, "timeout_ms": 5000},
      {"action": "assert", "source": "state", "path": "won", "op": "eq", "value": true},
      {"action": "click", "selector": "#restart"},
      {"action": "assert", "source": "state", "path": "score", "op": "eq", "value": 0},
      {"action": "assert", "source": "state", "path": "won", "op": "eq", "value": false},
      {"action": "assert", "source": "state", "path": "phase", "op": "eq", "value": "playing"},
      {"action": "assert", "source": "state", "path": "player", "op": "eq", "value_from": {"capture": "initial", "path": "player"}}
    ]}
  ],
  "manual_checks": [
    {"requirement_id": "R7", "instruction": "Check the blue square/yellow star, text/buttons and movement smoothness against the original requirement. Move continuously toward all four edges to confirm the whole square stays inside, and check that the display agrees with read-only state. Independent rechecks must not rewrite historical autonomous-run scores."}
  ]
}
